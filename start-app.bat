@echo off
chcp 65001 >nul
rem ============================================================
rem  WannaLog かんたん起動（ダブルクリックするだけ）
rem  1) 最新版を取りこむ  2) 必要な部品を入れる  3) アプリを起動
rem  ※このファイルは「いちばん上のフォルダ」に置いてください
rem    （app フォルダの“ひとつ外”です）
rem ============================================================
cd /d "%~dp0"

echo.
echo ============================================
echo   WannaLog を起動します
echo ============================================
echo.

echo [1/3] 最新版を取りこんでいます...
git pull origin claude/upbeat-bohr-1y69a2
echo.

cd app

echo [2/3] 必要な部品を確認しています（初回や更新時だけ時間がかかります）...
call npm install
echo.

echo [3/3] アプリを起動します。
echo   QRコードが出たら、iPhone のカメラで読んでください。
echo   （Expo Go で開きます）
echo.
call npx expo start --tunnel

echo.
echo ※ この黒いウィンドウを閉じると、アプリの配信は止まります。
echo   もう一度使うときは、またこのファイルをダブルクリックしてください。
pause
